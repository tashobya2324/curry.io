<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- ── TOP BAR ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="48dp"
                android:paddingBottom="16dp"
                android:background="#FFFFFF">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_no_food"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Logo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Curry.io"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="2dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@color/card_placeholder_2"
                            android:contentDescription="Profile" />

                    </androidx.cardview.widget.CardView>

                </FrameLayout>

            </LinearLayout>

            <!-- ── SEARCH BAR ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_search_bar"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Search restaurants or cuisines"
                    android:textColorHint="#AAAAAA"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:paddingStart="12dp"
                    android:inputType="text"
                    android:maxLines="1" />

            </LinearLayout>

            <!-- ── MODE TABS: Pre-order | Book a Table ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tabPreorder"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="Pre-order"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="24dp"
                    android:gravity="center"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tabBookTable"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="Book a Table"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_chip_active"
                    android:paddingHorizontal="24dp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- ── SECTION HEADER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Rated for Dining"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exceptional ambiance &amp; service"
                        android:textSize="13sp"
                        android:textColor="#888888" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all ›"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FEAE2C" />

            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!-- RESTAURANT CARD 1: The Amber Saffron  -->
            <!-- ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAmberSaffron"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Hero image with badges -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@color/card_placeholder_1"
                            android:contentDescription="The Amber Saffron" />

                        <!-- Rating badge top-right -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_rating_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_star"
                                android:layout_marginEnd="4dp"
                                app:tint="#FFFFFF"
                                android:contentDescription="Star" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.9"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                        <!-- Time badge bottom-left -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_dark_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_schedule"
                                android:layout_marginEnd="4dp"
                                app:tint="#FFFFFF"
                                android:contentDescription="Time" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15–20 min"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                    </FrameLayout>

                    <!-- Info section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Name + price row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="The Amber Saffron"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="#000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$$$"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#888888" />

                        </LinearLayout>

                        <!-- Cuisine + distance -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contemporary Indian"
                                android:textSize="13sp"
                                android:textColor="#888888" />

                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_dot_divider" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2.4 km"
                                android:textSize="13sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                        <!-- Book Now button -->
                        <Button
                            android:id="@+id/btnBook1"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_button_amber"
                            android:text="Book Now"
                            android:textColor="#000000"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:stateListAnimator="@null" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════ -->
            <!-- RESTAURANT CARD 2: Venezia Garden -->
            <!-- ══════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVenezia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@color/card_placeholder_3"
                            android:contentDescription="Venezia Garden" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_rating_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:src="@drawable/ic_star" app:tint="#FFFFFF"
                                android:layout_marginEnd="4dp" android:contentDescription="Star" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="4.8" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_dark_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:src="@drawable/ic_schedule" app:tint="#FFFFFF"
                                android:layout_marginEnd="4dp" android:contentDescription="Time" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="10–15 min" android:textSize="11sp" android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </FrameLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Venezia Garden"
                                android:textSize="17sp" android:textStyle="bold" android:textColor="#000000" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="$$" android:textSize="14sp" android:textStyle="bold" android:textColor="#888888" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Italian Fusion" android:textSize="13sp" android:textColor="#888888" />
                            <View android:layout_width="4dp" android:layout_height="4dp"
                                android:layout_marginHorizontal="6dp" android:background="@drawable/bg_dot_divider" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.8 km" android:textSize="13sp" android:textColor="#888888" />
                        </LinearLayout>

                        <Button android:id="@+id/btnBook2" android:layout_width="match_parent"
                            android:layout_height="50dp" android:background="@drawable/bg_button_amber"
                            android:text="Book Now" android:textColor="#000000" android:textSize="15sp"
                            android:textStyle="bold" android:stateListAnimator="@null" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ═══════════════════════════ -->
            <!-- RESTAURANT CARD 3: Kyoto   -->
            <!-- ═══════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardKyoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout android:layout_width="match_parent" android:layout_height="200dp">

                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop" android:src="@color/card_placeholder_2"
                            android:contentDescription="Kyoto Zen" />

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="top|end" android:layout_margin="12dp"
                            android:background="@drawable/bg_rating_badge" android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:src="@drawable/ic_star" app:tint="#FFFFFF"
                                android:layout_marginEnd="4dp" android:contentDescription="Star" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="4.7" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start" android:layout_margin="12dp"
                            android:background="@drawable/bg_dark_badge" android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:src="@drawable/ic_schedule" app:tint="#FFFFFF"
                                android:layout_marginEnd="4dp" android:contentDescription="Time" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="25–30 min" android:textSize="11sp" android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </FrameLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Kyoto Zen"
                                android:textSize="17sp" android:textStyle="bold" android:textColor="#000000" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="$$$$" android:textSize="14sp" android:textStyle="bold" android:textColor="#888888" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Japanese Fine Dining" android:textSize="13sp" android:textColor="#888888" />
                            <View android:layout_width="4dp" android:layout_height="4dp"
                                android:layout_marginHorizontal="6dp" android:background="@drawable/bg_dot_divider" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="3.1 km" android:textSize="13sp" android:textColor="#888888" />
                        </LinearLayout>

                        <Button android:id="@+id/btnBook3" android:layout_width="match_parent"
                            android:layout_height="50dp" android:background="@drawable/bg_button_amber"
                            android:text="Book Now" android:textColor="#000000" android:textSize="15sp"
                            android:textStyle="bold" android:stateListAnimator="@null" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ═══════════════════════════════ -->
            <!-- RESTAURANT CARD 4: Coastal Bites -->
            <!-- ═══════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCoastal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout android:layout_width="match_parent" android:layout_height="200dp">

                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop" android:src="@color/card_placeholder_3"
                            android:contentDescription="Coastal Bites" />

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="top|end" android:layout_margin="12dp"
                            android:background="@drawable/bg_rating_badge" android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:src="@drawable/ic_star" app:tint="#FFFFFF"
                                android:layout_marginEnd="4dp" android:contentDescription="Star" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="4.8" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start" android:layout_margin="12dp"
                            android:background="@drawable/bg_dark_badge" android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:src="@drawable/ic_schedule" app:tint="#FFFFFF"
                                android:layout_marginEnd="4dp" android:contentDescription="Time" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="15–20 min" android:textSize="11sp" android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </FrameLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Coastal Bites"
                                android:textSize="17sp" android:textStyle="bold" android:textColor="#000000" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="$$" android:textSize="14sp" android:textStyle="bold" android:textColor="#888888" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Seafood &amp; Grill" android:textSize="13sp" android:textColor="#888888" />
                            <View android:layout_width="4dp" android:layout_height="4dp"
                                android:layout_marginHorizontal="6dp" android:background="@drawable/bg_dot_divider" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="1.2 km" android:textSize="13sp" android:textColor="#888888" />
                        </LinearLayout>

                        <Button android:id="@+id/btnBook4" android:layout_width="match_parent"
                            android:layout_height="50dp" android:background="@drawable/bg_button_amber"
                            android:text="Book Now" android:textColor="#000000" android:textSize="15sp"
                            android:textStyle="bold" android:stateListAnimator="@null" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ── FLOATING ACTION BUTTON (calendar) ── -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/bg_button_amber"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_calendar"
            android:contentDescription="Reservations" />

    </FrameLayout>

    <!-- ── BOTTOM NAV ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#141A32"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>