<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Curry.io"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome back. Please enter your details."
            android:textSize="15sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp" />

        <!-- Email / Phone Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email or Phone Number"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Email / Phone Input -->
        <EditText
            android:id="@+id/etEmailOrPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp"
            android:hint="Enter your email or phone"
            android:textColorHint="#AAAAAA"
            android:textColor="#000000"
            android:textSize="15sp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="20dp" />

        <!-- Password Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Password Input + eye toggle -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:paddingEnd="52dp"
                android:hint="••••••••"
                android:textColorHint="#AAAAAA"
                android:textColor="#000000"
                android:textSize="15sp"
                android:inputType="textPassword" />

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_eye"
                android:contentDescription="Toggle password"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

        <!-- Forgot Password (right-aligned) -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="end"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp" />

        <!-- Log In Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_amber"
            android:text="Log In"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:layout_marginBottom="28dp" />

        <!-- OR CONTINUE WITH divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0E0E0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR CONTINUE WITH"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:letterSpacing="0.08"
                android:layout_marginHorizontal="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0E0E0" />

        </LinearLayout>

        <!-- Continue with Google -->
        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_outline_button"
            android:text="Continue with Google"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="12dp"
            android:paddingHorizontal="24dp"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp" />

        <!-- Continue with Apple -->
        <Button
            android:id="@+id/btnApple"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_outline_button"
            android:text="Continue with Apple"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_apple"
            android:drawablePadding="12dp"
            android:paddingHorizontal="24dp"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:layout_marginBottom="36dp" />

        <!-- Create account link -->
        <TextView
            android:id="@+id/tvCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Don\'t have an account? Create an account"
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>