<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── TOP BAR ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="48dp"
                android:paddingBottom="16dp"
                android:background="#FFFFFF">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your Orders"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginStart="12dp" />

                <!-- Profile avatar circle -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_today_badge" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:contentDescription="Profile" />

                </FrameLayout>

            </LinearLayout>

            <!-- Divider under top bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- ── TABS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Active tab -->
                    <LinearLayout
                        android:id="@+id/tabActive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingVertical="14dp">

                        <TextView
                            android:id="@+id/tvTabActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />

                        <!-- Active underline indicator -->
                        <View
                            android:id="@+id/indicatorActive"
                            android:layout_width="60dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="10dp"
                            android:background="#000000" />

                    </LinearLayout>

                    <!-- Past Orders tab -->
                    <LinearLayout
                        android:id="@+id/tabPast"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingVertical="14dp">

                        <TextView
                            android:id="@+id/tvTabPast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Past Orders"
                            android:textSize="15sp"
                            android:textColor="#AAAAAA" />

                        <!-- Inactive — hidden by default -->
                        <View
                            android:id="@+id/indicatorPast"
                            android:layout_width="60dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="10dp"
                            android:background="#000000"
                            android:visibility="invisible" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Full-width gray line below tabs -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

            </LinearLayout>

            <!-- ══════════════════════════════ -->
            <!-- ACTIVE TAB CONTENT            -->
            <!-- ══════════════════════════════ -->
            <LinearLayout
                android:id="@+id/contentActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- ── RESERVED TABLE CARD ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardReservation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_info_box"
                                android:layout_marginEnd="12dp">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_calendar"
                                    android:contentDescription="Reservation" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Table Reserved"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#000000" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Urban Masala"
                                    android:textSize="13sp"
                                    android:textColor="#888888" />
                            </LinearLayout>

                            <!-- Confirmed badge -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Confirmed"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32"
                                android:background="@drawable/bg_open_badge"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp" />

                        </LinearLayout>

                        <!-- Two info boxes -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Date box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_info_box"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Date"
                                    android:textSize="12sp"
                                    android:textColor="#AAAAAA"
                                    android:layout_marginBottom="4dp" />
                                <TextView
                                    android:id="@+id/tvReservationDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tue, 13"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#000000" />
                            </LinearLayout>

                            <!-- Party size box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_info_box"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Guests"
                                    android:textSize="12sp"
                                    android:textColor="#AAAAAA"
                                    android:layout_marginBottom="4dp" />
                                <TextView
                                    android:id="@+id/tvReservationGuests"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2 People"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#000000" />
                            </LinearLayout>

                            <!-- Time box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_info_box"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Time"
                                    android:textSize="12sp"
                                    android:textColor="#AAAAAA"
                                    android:layout_marginBottom="4dp" />
                                <TextView
                                    android:id="@+id/tvReservationTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="7:00 PM"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#000000" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Active Order header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Active Order"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <!-- 1 Live badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Live"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_live_badge"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp" />

                </LinearLayout>

                <!-- Active Order Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Row 1: Image + Name + Preparing badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <!-- Restaurant image -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_marginEnd="12dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@color/card_placeholder_1"
                                    android:contentDescription="Restaurant" />

                            </androidx.cardview.widget.CardView>

                            <!-- Name + location -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Urban Masala"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="#000000"
                                    android:layout_marginBottom="4dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_location_on"
                                        android:layout_marginEnd="3dp"
                                        app:tint="#AAAAAA"
                                        android:contentDescription="Location" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Kampala Branch"
                                        android:textSize="13sp"
                                        android:textColor="#888888" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Preparing badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_preparing_badge"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- Amber dot -->
                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_dot_divider" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Preparing"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#E65100" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 2: Two info boxes -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <!-- Estimated Arrival box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_info_box"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Estimated Arrival"
                                    android:textSize="12sp"
                                    android:textColor="#AAAAAA"
                                    android:layout_marginBottom="8dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_schedule"
                                        android:layout_marginEnd="5dp"
                                        android:contentDescription="Clock" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="1:15 PM"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="#000000" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Order ID box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_info_box"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Order ID"
                                    android:textSize="12sp"
                                    android:textColor="#AAAAAA"
                                    android:layout_marginBottom="8dp" />

                                <TextView
                                    android:id="@+id/tvOrderId"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="#UM-8291"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#000000" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- View Pickup QR Code button -->
                        <Button
                            android:id="@+id/btnViewQR"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_black_button"
                            android:text="View Pickup QR Code"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:drawableStart="@drawable/ic_qr_code"
                            android:drawablePadding="10dp"
                            android:stateListAnimator="@null"
                            android:layout_marginBottom="12dp" />

                        <!-- Amber progress bar at bottom of card -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:background="@drawable/bg_button_amber" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ══════════════════════════════ -->
            <!-- PAST ORDERS TAB CONTENT       -->
            <!-- ══════════════════════════════ -->
            <LinearLayout
                android:id="@+id/contentPast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="24dp"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your past orders will appear here."
                    android:textSize="15sp"
                    android:textColor="#888888"
                    android:gravity="center"
                    android:paddingVertical="40dp" />

            </LinearLayout>

            <!-- ══════════════════════════════ -->
            <!-- RECENT HISTORY (always shown) -->
            <!-- ══════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent History"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="12dp" />

            <!-- History Card 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@color/card_placeholder_2"
                            android:contentDescription="Kati Kati" />

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kati Kati"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:layout_marginBottom="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oct 24 • 1× Masala Dosa"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:layout_marginBottom="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UGX 18,000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />

                    </LinearLayout>

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_button_amber"
                        android:text="Reorder"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_format_list"
                        android:drawablePadding="6dp"
                        android:paddingHorizontal="14dp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- History Card 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@color/card_placeholder_3"
                            android:contentDescription="The Great Indian" />

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="The Great Indian"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:layout_marginBottom="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oct 20 • 2× Butter Chicken"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:layout_marginBottom="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UGX 42,000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />

                    </LinearLayout>

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_button_amber"
                        android:text="Reorder"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_format_list"
                        android:drawablePadding="6dp"
                        android:paddingHorizontal="14dp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ── BOTTOM NAV ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#141A32"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>